{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Knitout",
  "scopeName": "source.knitout",
  "patterns": [
    { "include": "#magic" },
    { "include": "#header" },
    { "include": "#tag-comment" },
    { "include": "#comment" },
    { "include": "#operation" }
  ],
  "repository": {
    "magic": {
      "comment": "The ;!knitout-N version line.",
      "match": "^\\s*(;!knitout-)([^\\s;]*)\\s*$",
      "captures": {
        "1": { "name": "keyword.control.directive.knitout" },
        "2": { "name": "constant.numeric.knitout" }
      }
    },
    "header": {
      "comment": "A ;;Name: value header line.",
      "match": "^\\s*(;;)([^:\\n]*)(:)?(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.knitout" },
        "2": { "name": "entity.name.tag.knitout" },
        "3": { "name": "punctuation.separator.knitout" },
        "4": { "name": "string.unquoted.knitout" }
      }
    },
    "tag-comment": {
      "comment": "A ;! tag directive that is not the magic line.",
      "match": "^\\s*(;!).*$",
      "name": "meta.directive.knitout",
      "captures": {
        "1": { "name": "keyword.control.directive.knitout" }
      }
    },
    "comment": {
      "comment": "A whole-line ; comment.",
      "match": "^\\s*;(?![;!]).*$",
      "name": "comment.line.semicolon.knitout"
    },
    "operation": {
      "comment": "An operation line: opcode, then arguments, then an optional trailing comment.",
      "begin": "^\\s*(x-[a-z0-9-]+|[a-zA-Z][a-zA-Z0-9-]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.opcode.knitout" }
      },
      "end": "(?=$)",
      "patterns": [
        { "include": "#trailing-comment" },
        { "include": "#direction" },
        { "include": "#needle" },
        { "include": "#number" }
      ]
    },
    "trailing-comment": {
      "match": "(;!.*|;(?!;).*)$",
      "name": "comment.line.trailing.knitout"
    },
    "direction": {
      "match": "(?<=\\s)[+-](?=\\s|$)",
      "name": "keyword.operator.direction.knitout"
    },
    "needle": {
      "match": "(?<![\\w-])[fb]s?-?\\d+(?![\\w])",
      "name": "entity.name.type.needle.knitout"
    },
    "number": {
      "match": "(?<![\\w-])-?\\d+(\\.\\d+)?(?![\\w])",
      "name": "constant.numeric.knitout"
    }
  }
}
