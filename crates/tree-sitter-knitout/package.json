{
  "name": "tree-sitter-knitout",
  "version": "0.1.0",
  "description": "Knitout (.k) is a file format that can represent low-level knitting machine instructions in a machine-independent way.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knitout-tools/knitout-tools.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "Nat Hurtig",
    "email": "nhurtig@acm.org",
    "url": "https://nathurtig.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "knitout"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
