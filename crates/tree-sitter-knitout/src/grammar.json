{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "knitout",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_newline"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "line"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_newline"
                      },
                      {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "SYMBOL",
                            "name": "line"
                          },
                          {
                            "type": "BLANK"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag_comment"
        },
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "op_line"
        }
      ]
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ";;"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "line_content"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ";"
        },
        {
          "type": "FIELD",
          "name": "text",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "line_content"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "op_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "operation",
          "content": {
            "type": "SYMBOL",
            "name": "operation"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "tag_comment",
                  "content": {
                    "type": "SYMBOL",
                    "name": "tag_comment"
                  }
                },
                {
                  "type": "FIELD",
                  "name": "comment",
                  "content": {
                    "type": "SYMBOL",
                    "name": "comment"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "operation": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opcode",
          "content": {
            "type": "SYMBOL",
            "name": "opcode"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "argument",
            "content": {
              "type": "SYMBOL",
              "name": "argument"
            }
          }
        }
      ]
    },
    "tag_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ";!"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "line_content"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "opcode": {
      "type": "PATTERN",
      "value": "[^\\s;]+"
    },
    "tag": {
      "type": "PATTERN",
      "value": "[^\\s]+"
    },
    "argument": {
      "type": "PATTERN",
      "value": "[^\\s;]+"
    },
    "line_content": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}